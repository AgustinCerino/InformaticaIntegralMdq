{
  "name": "informatica-integral-mdq",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/generate-seo.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false && npm run test:server",
    "test:server": "node --test tests/*.test.mjs",
    "audit:prod": "npm audit --omit=dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run build && npm run test:ci && npm run audit:prod",
    "serve:ssr:InformaticaIntegralMdq": "node dist/InformaticaIntegralMdq/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.10.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-server": "21.2.25",
    "@angular/router": "21.2.25",
    "@angular/ssr": "21.2.26",
    "express": "5.2.1",
    "nodemailer": "10.0.16",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "jsdom": "27.4.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
